# Alpine-Maintainer: Alex McGrath <amk@amk.ie>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=fcft
pkgver=3.3.2
pkgrel=0
pkgdesc="Simple library for font loading and glyph rasterization using FontConfig, FreeType and pixman"
url="https://codeberg.org/dnkl/fcft"
license="MIT"
arch="all"
depends="fontconfig freetype harfbuzz pixman utf8proc liblocale-shim"
depends_dev="fontconfig-dev freetype-dev harfbuzz-dev utf8proc-dev tllist-dev liblocale-shim-dev"
makedepends="
	meson
	scdoc
	$depends_dev
	"
checkdepends="check-dev font-dejavu font-noto-emoji" # tests require a font to be installed
subpackages="$pkgname-dev $pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://codeberg.org/dnkl/fcft/archive/$pkgver.tar.gz
    qnx-fix.patch
"
builddir="$srcdir/fcft"

build() {
	meson \
		-Dprefix=/usr \
		-Dsvg-backend=nanosvg \
		-Dtest-text-shaping=true \
		-Dc_args="-D_QNX_SOURCE -I/usr/include/shims" \
		-Dc_link_args="-llocale -lgcc_s" \
		. output
	 ninja -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}


sha512sums="
